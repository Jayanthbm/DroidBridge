<?xml version="1.0" encoding="utf-8"?>
<!--
  Lint policy.

  The default is: everything on, warnings are errors (see the root build.gradle.kts). A
  suppression is only acceptable when the finding is a deliberate, documented choice, so each
  entry below says why. Adding an entry here is a decision, not a way to get a green build.
-->
<lint>

    <!--
      The wrapper pins the Gradle version this build was verified against. Lint reports a newer
      Gradle release as an error; upgrading is a scheduled, verified change, not something to
      adopt mid-phase. Scoped to the wrapper file so the AGP version is still checked.
    -->
    <issue id="AndroidGradlePluginVersion">
        <ignore path="gradle/wrapper/gradle-wrapper.properties" />
        <ignore path="gradle/libs.versions.toml" />
    </issue>

    <!--
      "A newer version of this dependency exists" is a release notification, not a defect: it turns
      red purely because time passed, with no change in this repository. It is tracked as a scheduled
      upgrade rather than a CI gate, because a red run has to mean something broke. Verified
      2026-11-21: after the AGP 9.5.2 / Compose 2026.11.01 / compileSdk 37.1 upgrade these checks
      report nothing, so this ignore is insurance against the next release, not cover for a finding.
      Code-level lint findings are still errors.
    -->
    <issue id="GradleDependency">
        <ignore path="gradle/libs.versions.toml" />
    </issue>

</lint>
