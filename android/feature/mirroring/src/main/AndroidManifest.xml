<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Phase 4 permissions, promoted from the P08 experiment now that the phase owns this feature.
      Each one is justified here so PERMISSIONS_MATRIX.md can be checked against the manifest rather
      than against prose.

      FOREGROUND_SERVICE + FOREGROUND_SERVICE_MEDIA_PROJECTION: screen capture must run in a
      foreground service with the mediaProjection type, or Android stops it (R-04).
      POST_NOTIFICATIONS: the capture service's ongoing notification, requested at the moment
      mirroring starts and never at launch.

      RECORD_AUDIO (owner-approved 2026-11-26, ADR-057): playback audio. The permission is only
      ever used with `AudioPlaybackCaptureConfiguration` bound to the same MediaProjection consent
      that screen capture uses — it is not microphone input, and the capture configuration names
      exactly the three usages it may hear (media, game, unknown). The dialog is requested when the
      user turns audio on and starts a share, never at launch, and a denial only removes the audio
      track. `microphone` is declared as a foreground-service type because Android 14+ classifies a
      service that records audio — even playback audio — under it while the mediaProjection type
      covers the screen.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <!--
          stopWithTask="false": the stream continues when the activity is swiped away, because the
          user asked for a mirroring session rather than for an activity. The notification's Stop
          action and the system's screen-sharing chip both end it explicitly.
        -->
        <service
            android:name=".MirroringService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone"
            android:stopWithTask="false" />
    </application>
</manifest>
