<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Phase 4 permissions, promoted from the P08 experiment now that the phase owns this feature.
      Each one is justified here so PERMISSIONS_MATRIX.md can be checked against the manifest rather
      than against prose.

      FOREGROUND_SERVICE + FOREGROUND_SERVICE_MEDIA_PROJECTION: screen capture must run in a
      foreground service with the mediaProjection type, or Android stops it (R-04).
      POST_NOTIFICATIONS: the capture service's ongoing notification, requested at the moment
      mirroring starts and never at launch.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
          stopWithTask="false": the stream continues when the activity is swiped away, because the
          user asked for a mirroring session rather than for an activity. The notification's Stop
          action and the system's screen-sharing chip both end it explicitly.
        -->
        <service
            android:name=".MirroringService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="false" />
    </application>
</manifest>
