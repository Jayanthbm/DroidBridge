<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Phase 2 permissions. Each is justified in Docs/PERMISSIONS_MATRIX.md before it is added here.

      INTERNET: the LAN session and NSD. Normal permission; on targetSdk 37 the local-network access
      it used to imply is no longer granted implicitly.
      ACCESS_LOCAL_NETWORK: required on API 37 to resolve and connect to a discovered service. It is
      declared and requested in context at the moment the user taps "Find the Mac", never at launch.
      On devices below API 37 the permission does not exist and the request is a no-op.

      Deliberately still absent: FOREGROUND_SERVICE* (no background session yet — that is ADR-023's
      P14 decision, not Phase 2), POST_NOTIFICATIONS (no notifications), BLUETOOTH* (ADR-016), and
      every clipboard permission (none exists; clipboard needs foreground focus, R-09).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DroidBridge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DroidBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
