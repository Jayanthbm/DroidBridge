<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Phase 2 permissions. Each is justified in Docs/PERMISSIONS_MATRIX.md before it is added here.

      INTERNET: the LAN session and NSD. Normal permission; on targetSdk 37 the local-network access
      it used to imply is no longer granted implicitly.
      ACCESS_LOCAL_NETWORK: required on API 37 to resolve and connect to a discovered service. It is
      declared and requested in context at the moment the user taps "Find the Mac", never at launch.
      On devices below API 37 the permission does not exist and the request is a no-op.

      Phase 4 adds screen capture, so FOREGROUND_SERVICE, FOREGROUND_SERVICE_MEDIA_PROJECTION and
      POST_NOTIFICATIONS arrive from `:feature:mirroring` (its manifest declares them with the same
      justifications). Mirroring is started by an explicit button, never automatically.

      Deliberately still absent: BLUETOOTH* (ADR-016), every clipboard permission (none exists;
      clipboard needs foreground focus, R-09), and RECORD_AUDIO (experiment-scoped only, ADR-045).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DroidBridge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DroidBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
