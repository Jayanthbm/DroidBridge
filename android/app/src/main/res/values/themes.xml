<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The Compose MaterialTheme in DashboardScreen owns the real styling. This platform theme
      only needs to exist so the window has a sane background before Compose draws, and so the
      app does not inherit a translucent or action-bar theme from the platform default.
    -->
    <style name="Theme.DroidBridge" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/background_dark</item>
    </style>
</resources>
