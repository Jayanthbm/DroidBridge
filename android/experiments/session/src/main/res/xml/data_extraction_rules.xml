<?xml version="1.0" encoding="utf-8"?>
<!--
  No backup, no device transfer. The experiment stores pairing pins in its own preferences and
  nothing else; a confirmed pin belongs to this install and must not travel to another device.
  Declaring the exclusion explicitly is better than relying on allowBackup alone, which is
  deprecated from Android 12.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
