<?xml version="1.0" encoding="utf-8"?>
<!--
  No backup, no device transfer. The only thing this experiment persists is a pairing pin, and a
  confirmed pin belongs to one install: it must not travel with a restored backup to a device that
  never compared the code.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
