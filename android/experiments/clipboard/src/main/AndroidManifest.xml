<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      P04 declares no permission, deliberately.

      The prototype exists to establish when Android permits a clipboard read. There is no
      clipboard permission on Android at all: access is gated on the app being the focused,
      visible app. Declaring one would be meaningless, and declaring anything else would change
      the thing being measured.
    -->

    <!--
      Guards ProbeReceiver. A signature permission cannot be held by another app, but adb shell
      runs privileged and can still send the broadcast, which is all the prototype needs. Without
      it any installed app could trigger a clipboard read.
    -->
    <permission
        android:name="com.droidbridge.experiment.clipboard.PROBE_PERMISSION"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/experiment_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DroidBridgeExperiment">

        <activity
            android:name=".ClipboardActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Prototype-only: lets the P04 matrix measure a clipboard read while another app holds
          focus. Not exported in any production build.
        -->
        <receiver
            android:name=".ProbeReceiver"
            android:exported="true"
            android:permission="com.droidbridge.experiment.clipboard.PROBE_PERMISSION">
            <intent-filter>
                <action android:name="com.droidbridge.experiment.clipboard.PROBE" />
            </intent-filter>
        </receiver>

        <!-- Only so the image-only matrix row can put a real image/* clip on the clipboard. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.p04files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/p04_file_paths" />
        </provider>
    </application>

</manifest>
