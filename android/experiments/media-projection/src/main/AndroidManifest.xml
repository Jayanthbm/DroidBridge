<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      P01 experiment manifest. Every permission here is justified by the prototype itself
      (Docs/PROTOTYPE_PLAN.md P01), and this app is never shipped or depended on by :app.

      - FOREGROUND_SERVICE: required since Android 14 for any foreground service.
      - FOREGROUND_SERVICE_MEDIA_PROJECTION: required for the `mediaProjection` service type;
        a missing type throws MissingForegroundServiceTypeException (R-04).
      - POST_NOTIFICATIONS: without it the FGS notification is hidden from the drawer and the
        service is only visible in the FGS Task Manager (R-21). Requested in context, not at
        first launch.

      Deliberately absent: INTERNET, ACCESS_LOCAL_NETWORK, BLUETOOTH*, RECORD_AUDIO, and every
      clipboard permission. P01 captures and encodes locally; it transmits nothing.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/experiment_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DroidBridgeExperiment">

        <activity
            android:name=".ExperimentActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          A white comparison surface for the FLAG_SECURE test. Not exported: only the experiment
          activity opens it, and exporting a test surface would widen the debug app's attack
          surface for no benefit.
        -->
        <activity
            android:name=".ContentTestActivity"
            android:exported="false"
            android:label="P01 content test" />

        <!--
          The projection service. `stopWithTask="false"` is deliberate: the session must survive
          the activity going to the background, which is the whole point of a foreground service.
          The service stops itself when MediaProjection reports onStop.
        -->
        <service
            android:name=".ProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="false" />
    </application>

</manifest>
