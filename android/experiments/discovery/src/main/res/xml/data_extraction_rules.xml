<?xml version="1.0" encoding="utf-8"?>
<!--
  No backup, no device transfer. This app stores no user data: it measures the local-network
  discovery path and forgets everything when the process ends. Declaring the exclusion explicitly
  is better than relying on allowBackup alone, which is deprecated from Android 12.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
