<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  P17 experiment only. The App Sandbox is intentionally NOT enabled here:
	  Bluetooth Classic (IOBluetooth) device-role publication and outbound L2CAP are
	  exercised locally, and a sandbox profile would need separate verification first.
	  This file must not be adopted by the production target without that review.
	-->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
</dict>
</plist>
